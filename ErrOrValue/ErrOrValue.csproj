<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ErrOrValue</PackageId>
    <Version>6.0.1</Version>
    <Authors>Johnny Madigan</Authors>
    <Description>Lightweight errors as values for ASP.NET projects.</Description>
    <PackageIcon>ErrOrValue.png</PackageIcon>
    <PackageTags>errors-as-values;error-handling;result;union-types;pattern-matching;aspnetcore;minimal-api;dotnet;lightweight;type-safety</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jjawny/ErrOrValue</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jjawny/ErrOrValue</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../ErrOrValue.png" Pack="true" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
